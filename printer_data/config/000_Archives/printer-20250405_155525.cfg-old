#####################################################################
#   LED Control
#####################################################################

## Chamber Lighting - HE2 Connector (Optional)
[output_pin caselight]
pin: PB10
pwm:true
shutdown_value: 0
value:1
cycle_time: 0.01

#####################################################################
#   Homing and Gantry Adjustment Routines
#####################################################################

[idle_timeout]
timeout: 5000

#[safe_z_home]
##  XY Location of the Z Endstop Switch
##  Update -10,-10 to the XY coordinates of your endstop pin 
##  (such as 157,305) after going through Z Endstop Pin
##  Location Definition step.
#home_xy_position:228,350
#speed:100
#z_hop:10

[quad_gantry_level]
##  Use QUAD_GANTRY_LEVEL to level a gantry.
##  Min & Max gantry corners - measure from nozzle at MIN (0,0) and 
##  MAX (250, 250), (300,300), or (350,350) depending on your printer size
##  to respective belt positions

#--------------------------------------------------------------------
##  Gantry Corners for 250mm Build
##  Uncomment for 250mm build
#gantry_corners:
#   -60,-10
#   310, 320
##  Probe points
#points:
#   50,25
#   50,175
#   200,175
#   200,25
    
##  Gantry Corners for 300mm Build
##  Uncomment for 300mm build
#gantry_corners:
#   -60,-10
#   360,370
##  Probe points
#points:
#   50,25
#   50,225
#   250,225
#   250,25

##  Gantry Corners for 350mm Build
##  Uncomment for 350mm build
gantry_corners:
   -70.25,-0.25   # Default: -60,-10
   420.75,430.75   # Default: 410,420
#  Probe points
points:
   50,25     # Default: 50,25
   50,275.5    # Default: 50,275
   300.5,275.5   # Default: 300,275
   300.5,25    # Default: 300,25

#--------------------------------------------------------------------
speed: 100                # 75                # Default: 100
horizontal_move_z: 15     # Default: 15
retries: 7                # Default: 5 
retry_tolerance: 0.0040   # Default: 0.0075 
max_adjust: 40            # Default: 20

########################################
# EXP1 / EXP2 (display) pins
########################################

[board_pins]
aliases:
    # EXP1 header
    EXP1_1=PE8, EXP1_2=PE7,
    EXP1_3=PE9, EXP1_4=PE10,
    EXP1_5=PE12, EXP1_6=PE13,    # Slot in the socket on this side
    EXP1_7=PE14, EXP1_8=PE15,
    EXP1_9=<GND>, EXP1_10=<5V>,

    # EXP2 header
    EXP2_1=PA6, EXP2_2=PA5,
    EXP2_3=PB1, EXP2_4=PA4,
    EXP2_5=PB2, EXP2_6=PA7,      # Slot in the socket on this side
    EXP2_7=PC15, EXP2_8=<RST>,
    EXP2_9=<GND>, EXP2_10=<5V>

#####################################################################
#   Displays
#####################################################################

##  Uncomment the display that you have
#--------------------------------------------------------------------

#[display]
##  RepRapDiscount 128x64 Full Graphic Smart Controller
#lcd_type: st7920
#cs_pin: EXP1_4
#sclk_pin: EXP1_5
#sid_pin: EXP1_3
#menu_timeout: 40
#encoder_pins: ^EXP2_5, ^EXP2_3
#click_pin: ^!EXP1_2

#[output_pin beeper]
#pin: EXP1_1

#--------------------------------------------------------------------

[display]
##  mini12864 LCD Display
lcd_type: uc1701
cs_pin: EXP1_3
a0_pin: EXP1_4
rst_pin: EXP1_5
encoder_pins: ^EXP2_5, ^EXP2_3
click_pin: ^!EXP1_2
contrast: 63
spi_software_miso_pin: EXP2_1
spi_software_mosi_pin: EXP2_6
spi_software_sclk_pin: EXP2_2

[neopixel btt_mini12864]
##  To control Neopixel RGB in mini12864 display
pin: EXP1_6
chain_count: 3
initial_RED: 0.0         # Default: 0.1
initial_GREEN: 0.0       # Default: 0.5
initial_BLUE: 0.5        # Default: 0.0
color_order: RGB

##  Set RGB values on boot up for each Neopixel. 
##  Index 1 = display, Index 2 and 3 = Knob
#[delayed_gcode setdisplayneopixel]
#initial_duration: 1
#gcode:
#        SET_LED LED=btt_mini12864 RED=1 GREEN=1 BLUE=1 INDEX=1 TRANSMIT=0
#        SET_LED LED=btt_mini12864 RED=1 GREEN=0 BLUE=0 INDEX=2 TRANSMIT=0
#        SET_LED LED=btt_mini12864 RED=1 GREEN=0 BLUE=0 INDEX=3 

#--------------------------------------------------------------------

[bed_mesh]
speed: 300
horizontal_move_z: 15  # Default: 10
##--------------------------------------------------------------------

##	Uncomment for 350mm build
mesh_min: 40,40
mesh_max: 310,310
##--------------------------------------------------------------------
fade_start: 1   # 0.6
fade_end: 10.0
probe_count: 5,3      # 7,7
mesh_pps: 2,3  # new
algorithm: bicubic
bicubic_tension: 0.2  # Default: 0.2
zero_reference_position: 175.5, 175.5
move_check_distance: 5
split_delta_z: .025
#faulty_region_1_min: 160.5, 160.5
#faulty_region_1_max: 190.5, 190.5
#zero_reference_position:
#   An optional X,Y coordinate that specifies the location on the bed
#   where Z = 0.  When this option is specified the mesh will be offset
#   so that zero Z adjustment occurs at this location.  The default is
#   no zero reference.
#relative_reference_index:
#   **DEPRECATED, use the "zero_reference_position" option**
#   The legacy option superceded by the "zero reference position".
#   Rather than a coordinate this option takes an integer "index" that
#   refers to the location of one of the generated points. It is recommended
#   to use the "zero_reference_position" instead of this option for new
#   configurations. The default is no relative reference index.
#relative_reference_index: 24
#relative_reference_index = ()(x points * y points) - 1) / 2

[gcode_arcs]
resolution: 1.0
#   An arc will be split into segments. Each segment's length will
#   equal the resolution in mm set above. Lower values will produce a
#   finer arc, but also more work for your machine. Arcs smaller than
#   the configured value will become straight lines. The default is
#   1mm.

#[adxl345]
#cs_pin: rpi:None

#[#resonance_tester]
#accel_chip: adxl345
#probe_points:
#    174, 174, 100  # an example

[input_shaper]
#shaper_type_x = mzv
#shaper_freq_x = 57.0
#shaper_type_y = zv
#shaper_freq_y = 44.0

[exclude_object]

#####################################################################
#   Macros
#####################################################################


#####################################################################
# SEARCH_VARS
# 
# 
# SEARCH_VARS S={some word}
# SEARCH_VARS s="profile"
# SEARCH_VARS s="gcode_move"

[gcode_macro SEARCH_VARS]
gcode:
    {% set search = params.S|lower %}
    {% set ns = namespace() %}
    {% for item in printer  %}
        {% if ' ' in item %}
            {% set ns.path = ['printer', "['%s']" % (item), ''] %}
        {% else %}
            {% set ns.path = ['printer.', item, ''] %}   
        {% endif %} 

        {% if search in ns.path|lower %}
            { action_respond_info(ns.path|join) }
        {% endif %} 

        {% if printer[item].items() %}
            {% for childkey, child in printer[item].items() recursive %}
                {% set ns.path = ns.path[:loop.depth|int + 1] %}

                {% if ' ' in childkey %}
                    {% set null = ns.path.append("['%s']" % (childkey)) %}
                {% else %}
                    {% set null = ns.path.append(".%s" % (childkey)) %}
                {% endif %} 

                {% if child is mapping  %}
                    { loop(child.items()) }
                {% else %}
                    {% if search in ns.path|lower %}
                        { action_respond_info("%s : %s" % (ns.path|join, child)) }   
                    {% endif %} 
                {% endif %} 
                
            {% endfor %}
        {% endif %} 
    {% endfor %}


#####################################################################
# DEBUG_DUMP_VARS
# 
# 
[gcode_macro DEBUG_DUMP_VARS]
gcode:
    {% set donotwant = ['bed_mesh', 'configfile'] %}
    {% set parameters = [] %}
    {% for name1 in printer | sort %}
        {% if 'S' in params %}
            {% if name1 is in [params.S] %}
                {% for name2 in printer[name1] | sort %}
                    {% set parameters = parameters.append("printer['%s'].%s = %s" % (name1, name2, printer[name1][name2])) %}
                {% endfor %}
            {% endif %}
        {% else %}
            {% if name1 is not in donotwant %}
                {% for name2 in printer[name1] | sort %}
                    {% set parameters = parameters.append("printer['%s'].%s = %s" % (name1, name2, printer[name1][name2])) %}
                {% endfor %}
            {% endif %}
        {% endif %}
    {% endfor %}
    { action_respond_info(parameters | join("\n")) }


# [gcode_macro CLEAN_NOZZLE]
# # Comment
# gcode:
#     SET_NOZZLE_LEDS_ON
#     G90                                           ; absolute positioning
#     BRUSH_POSITION   
#     BRUSH_POSITION_END_X_Y
#     BRUSH_POSITION_X_Y
#     BRUSH_POSITION_END_X_Y
#     BRUSH_POSITION_X_Y
#     BRUSH_POSITION_END_X_Y
#     BRUSH_POSITION_X_Y
#     G90 
#     G0 Z20 F3600
#     PURGE_BUCKET_POSITION
#     #SET_NOZZLE_LEDS_OFF


[gcode_macro PURGE_FILAMENT]
# Comment
gcode:
    SAVE_GCODE_STATE NAME=PURGE
    G90                               ; absolute
    PURGE_BUCKET_POSITION
    #SET_NOZZLE_LEDS_ON
    M83                               ; relative position
    G1 E10 F500                       ; purge some filament into bucket
    G1 E3 F500                        ; purge some filament into bucket
    BRUSH_POSITION
    G90                               ; absolute
    G0 X120 Y358 F750                 ; brush once slow
    G0 X80 Y358 F750                  ; brush position X only
    M83                               ; relative position
    G1 E-2 F500                       ; Retract a little
    PURGE_BUCKET_POSITION
    #CLEAN_NOZZLE
    #SET_NOZZLE_LEDS_OFF
    RESTORE_GCODE_STATE NAME=PURGE


[gcode_macro CG28]
# Conditional G28 (home if not already homed)
gcode:
    {% if "x" not in printer.toolhead.homed_axes or "y" not in printer.toolhead.homed_axes or "z" not in printer.toolhead.homed_axes %}
       G28
    {% endif %}

[gcode_macro C_CALIBRATE_Z]
# Conditional CALIBRATE_Z (CALIBRATE_Z if Z not calibrated)
gcode:
    {% if printer.z_calibration.last_query != True %}
      CALIBRATE_Z
    {% endif %}

[gcode_macro CQGL]
# Conditional QUAD_GANTRY_LEVEL (QUAD_GANTRY_LEVEL if not already QUAD_GANTRY_LEVEL)
gcode:
    {% if printer.quad_gantry_level.applied == False %}
       QUAD_GANTRY_LEVEL                    ; Level
       CLEAN_NOZZLE
       G28 Z
    {% endif %}

[gcode_macro CG32]
# Explanation
gcode:
    G32
    PURGE_BUCKET_POSITION

[gcode_macro G32]
gcode:
    SAVE_GCODE_STATE NAME=STATE_G32
    BED_MESH_CLEAR
    CG28                                 ; Home if not homed to get everything turned on
    CQGL                                 ; Level if not Level
    # G28 X Y                            ; Home the X and Y
    CLEAN_NOZZLE
    G28 Z                                ; Home the Z now that nozzle is clean
    PURGE_BUCKET_POSITION
    RESTORE_GCODE_STATE NAME=STATE_G32


[gcode_macro MOVE_CENTER_BED_NOZZLE]
gcode:
    G90                                           ; absolute positioning
    G0 Z25  F3000 
    G0 X175.25 Y175.25  F3600                           ; safe move nozzle to center of the bed

[gcode_macro _MOVE_CENTER_BED_PROBE]
gcode:
    G90                                           ; absolute positioning
    G0 Z25  F3000 
    G0 X156.25 Y155.25  F3600                           ; safe move probe to center of the bed

[gcode_macro TOOL_HEATING_HEAD_MAINTENANCE_POSITION]
gcode:
    G90                                           ; absolute positioning
    G0 Z150  F3000 
    G0 X175 Y0  F3600                           ; safe move tool to front center for Maintenance

[gcode_macro BED_CENTER_PROBE_ACCURACY]
gcode:
    SAVE_GCODE_STATE NAME=BCPA
    G90                                           ; absolute positioning
    G0 Z20 F3600
    _MOVE_CENTER_BED_PROBE
    PROBE_ACCURACY  
    RESTORE_GCODE_STATE NAME=BCPA
    M117 Recommendation: Standard deviation EqSmaller then 0.004
    M117 Recommendation: Range EqSmaller then 0.0125






[gcode_macro Z_FRONT_LEFT_ACCURACY_CHECK]
gcode:
    SAVE_GCODE_STATE NAME=ZCHECK
    G90                                           ; absolute positioning
    M117 Front Left Check
    G0 Z20 F3600
    STEPPER_BUZZ STEPPER=stepper_z
    G0 X50 Y25 F3600
    PROBE_ACCURACY  
    M117 Recommendation: Standard deviation EqSmaller then 0.004
    M117 Recommendation: Range EqSmaller then 0.0125
    RESTORE_GCODE_STATE NAME=ZCHECK

